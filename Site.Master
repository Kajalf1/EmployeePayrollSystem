<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="EmployeePayrollSystem.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Employee Payroll System</title>

    <webopt:bundlereference runat="server" path="~/Content/css" />

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f5f6fa;
        }

        .topbar {
            height: 65px;
            background-color: #1f2937;
            color: white;
            display: flex;
            align-items: center;
            padding: 0 30px;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .main-container {
            display: flex;
            min-height: calc(100vh - 65px);
        }

        .sidebar {
            width: 230px;
            background-color: #111827;
            min-height: calc(100vh - 65px);
            padding-top: 20px;
        }

        .sidebar a {
            display: block;
            color: #d1d5db;
            text-decoration: none;
            padding: 14px 25px;
            font-size: 15px;
        }

        .sidebar a:hover {
            background-color: #374151;
            color: white;
        }

        .sidebar .logout-button {
            display: block;
            width: 100%;
            box-sizing: border-box;
            background: none;
            border: none;
            color: #d1d5db;
            text-align: left;
            padding: 14px 25px;
            font-size: 15px;
            cursor: pointer;
        }

        .sidebar .logout-button:hover {
            background-color: #374151;
            color: white;
        }

        .content {
            flex: 1;
            padding: 30px;
        }

        .page-title {
            font-size: 28px;
            font-weight: bold;
            color: #1f2937;
            margin-bottom: 25px;
        }

        .footer {
            text-align: center;
            padding: 15px;
            background-color: #1f2937;
            color: white;
        }

    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <!-- TOP BAR -->

    <div class="topbar">

        <div class="logo">
            Employee Payroll System
        </div>

    </div>


    <!-- MAIN CONTAINER -->

    <div class="main-container">

        <!-- SIDEBAR -->

        <div class="sidebar">

            <!-- ADMIN MENU -->

            <asp:Panel
                ID="pnlAdminMenu"
                runat="server">

                <a href="AdminDashboard.aspx">Dashboard</a>

                <a href="Employees.aspx">Employees</a>

                <a href="Departments.aspx">Departments</a>

                <a href="Attendance.aspx">Attendance</a>

                <a href="Salary.aspx">Salary</a>

                <a href="Payslip.aspx">Payslip</a>

                <asp:LinkButton
                    ID="lnkAdminLogout"
                    runat="server"
                    CssClass="logout-button"
                    OnClick="lnkLogout_Click">
                    Logout
                </asp:LinkButton>

            </asp:Panel>


            <!-- EMPLOYEE MENU -->

            <asp:Panel
                ID="pnlEmployeeMenu"
                runat="server">

                <a href="EmployeeDashboard.aspx">Dashboard</a>

                <a href="EmployeeAttendance.aspx">
                    My Attendance
                </a>

                <a href="EmployeeSalary.aspx">
                    My Salary
                </a>

                <a href="EmployeePayslip.aspx">
                    My Payslip
                </a>

                <asp:LinkButton
                    ID="lnkEmployeeLogout"
                    runat="server"
                    CssClass="logout-button"
                    OnClick="lnkLogout_Click">
                    Logout
                </asp:LinkButton>

            </asp:Panel>

        </div>


        <!-- PAGE CONTENT -->

        <div class="content">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </div>


    <!-- FOOTER -->

    <div class="footer">

        © 2026 Employee Payroll System

    </div>

</form>

</body>

</html>